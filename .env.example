# Local development. Copy to .env (git-ignored) and change the passwords.
# Read by compose.yaml (Docker Compose) and by Spring Boot.
# No quotes around values. Never put real secrets in this file.

# --- Local MySQL 8.x (compose.yaml) ---
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=change-me-local
MYSQL_ROOT_PASSWORD=change-me-root
# Host port for MySQL. Change if 3306 is taken by a local MySQL install.
MYSQL_PORT=3306

# --- Backend (Spring) ---
# Allowed Origin for write requests. Defaults to this value when unset.
APP_ORIGIN=http://localhost:5173

# 시연용 고정 계정 비밀번호(시드 실행기 #141). 비어 있으면 그 계정은 만들지 않는다. 값은 커밋하지 않는다.
DEMO_CUSTOMER_PASSWORD=
DEMO_OWNER_PASSWORD=
DEMO_ASSOCIATION_PASSWORD=
